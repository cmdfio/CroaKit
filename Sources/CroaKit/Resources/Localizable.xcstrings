    "Actualisation indisponible. Les dernières apps chargées restent affichées." : {
      "comment" : "Shown above the catalog when a refresh failed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحديث. ما زالت آخر التطبيقات المحمّلة معروضة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisierung nicht möglich. Die zuletzt geladenen Apps werden weiter angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t refresh. The last apps loaded are still shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido actualizar. Se siguen mostrando las últimas apps cargadas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiornamento non disponibile. Restano visibili le ultime app caricate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新できません。最後に読み込んだアプリを表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 고칠 수 없습니다. 마지막으로 불러온 앱이 계속 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível atualizar. Os últimos apps carregados continuam na tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法刷新。仍显示上次载入的 App。"
          }
        }
      }
    },
